---
layout: layouts/base.njk
title: Insights
description: Practical articles on websites, search, speed and automation for businesses, plus developer notes.
permalink: /insights/
eleventyExcludeFromCollections: true
---
<section class="page-hero">
  <div class="container">
    <p class="eyebrow">Insights</p>
    <h1 class="h-xl" style="max-width:18ch">How technology helps businesses grow.</h1>
    <p class="lead">Plain-language articles on websites, search, speed and automation. Plus developer notes on the tools and habits behind the work.</p>
  </div>
</section>

<section aria-label="Articles">
  <div class="container">
    <div class="filters" data-filter-group="post-list" role="group" aria-label="Filter articles">
      <button class="filter-btn" type="button" data-filter="all" aria-pressed="true">All</button>
      <button class="filter-btn" type="button" data-filter="business" aria-pressed="false">For businesses</button>
      <button class="filter-btn" type="button" data-filter="developer" aria-pressed="false">Developer notes</button>
    </div>
    <div class="post-list" id="post-list">
      {% for post in collections.insights %}
      <a class="post-row reveal" href="{{ post.url }}" data-tags="{{ post.data.group }}">
        {% if post.data.image %}
        <div class="post-thumb"><img src="{{ post.data.image }}" alt="" loading="lazy" width="440" height="275"></div>
        {% else %}
        <div class="post-thumb post-thumb-text"><span>{{ post.data.category }}</span></div>
        {% endif %}
        <div>
          <span class="tag" style="margin-bottom:0.75rem">{{ post.data.category }}</span>
          <h3>{{ post.data.title }}</h3>
          <p>{{ post.data.description }}</p>
        </div>
        <time class="post-date" datetime="{{ post.date | isoDate }}">{{ post.date | readableDate }}</time>
      </a>
      {% endfor %}
    </div>
  </div>
</section>

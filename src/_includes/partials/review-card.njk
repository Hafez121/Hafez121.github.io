{# Shows only what the client agreed to publish (see the `consent` list in each review file). #}
{% set d = review.data %}
{% set showName = d.consent and ("name" in d.consent) %}
<figure class="review-card reveal">
  {% if d.rating %}<p class="stars" aria-label="{{ d.rating }} out of 5">{% for i in range(0, d.rating) %}&#9733;{% endfor %}</p>{% endif %}
  <blockquote class="review-quote">{{ review.content | safe }}</blockquote>
  <figcaption class="review-who">
    {% if showName and d.photo %}<img class="review-avatar" src="{{ d.photo }}" alt="" width="44" height="44" loading="lazy">{% endif %}
    <div>
      <p class="review-name">{{ d.name if showName else "Verified client" }}</p>
      <p class="review-role">{% if showName %}{{ d.role }}{% if d.business %}, {{ d.business }}{% endif %}{% else %}{{ d.industry }}{% endif %}</p>
    </div>
  </figcaption>
  <div class="review-foot">
    <time datetime="{{ review.date | isoDate }}">{{ review.date | readableDate }}</time>
    {% if d.source_url %}<a href="{{ d.source_url }}" rel="noopener">Read on {{ d.source | capitalize }}</a>{% else %}<span>Sent directly, with written permission</span>{% endif %}
    {% if d.case_study %}<a href="/work/{{ d.case_study }}/">See the project</a>{% endif %}
  </div>
</figure>

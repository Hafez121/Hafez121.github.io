{# Visual explainer: problem on the left, fix on the right, three steps underneath. Expects `ex` in scope. #}
<figure class="explainer reveal" aria-label="Before: {{ ex.before }}. After: {{ ex.after }}.">
  <div class="ex-row">
    <div class="ex-box ex-before">
      <span class="ex-label">Before</span>
      <p>{{ ex.before }}</p>
    </div>
    <svg class="ex-arrow" viewBox="0 0 64 24" aria-hidden="true" focusable="false">
      <path d="M2 12h56" pathLength="1"/>
      <path d="M50 4l8 8-8 8" pathLength="1"/>
    </svg>
    <div class="ex-box ex-after">
      <span class="ex-label">After</span>
      <p>{{ ex.after }}</p>
    </div>
  </div>
  <ol class="ex-steps">
    {% for step in ex.steps %}
    <li><span class="ex-num">{{ loop.index | pad }}</span>{{ step }}</li>
    {% endfor %}
  </ol>
</figure>

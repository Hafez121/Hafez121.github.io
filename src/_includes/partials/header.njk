{% set nav = [
  { url: "/services/", label: "Services" },
  { url: "/work/", label: "Work" },
  { url: "/insights/", label: "Insights" },
  { url: "/about/", label: "About" }
] %}
<header class="site-header">
  <nav class="nav" aria-label="Main">
    <a class="nav-brand" href="/">Hafez Fandy</a>
    <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="nav-menu">
      <span class="sr-only">Menu</span>
      <span class="nav-toggle-bar"></span>
      <span class="nav-toggle-bar"></span>
    </button>
    <ul class="nav-links" id="nav-menu">
      {% for item in nav %}
      <li><a href="{{ item.url }}"{% if page.url.startsWith(item.url) %} aria-current="page"{% endif %}>{{ item.label }}</a></li>
      {% endfor %}
      {% if collections.reviews.length %}
      <li><a href="/reviews/"{% if page.url.startsWith('/reviews/') %} aria-current="page"{% endif %}>Reviews</a></li>
      {% endif %}
      <li class="nav-cta-item"><a class="btn btn-small" href="/website-check/">Free website check</a></li>
    </ul>
  </nav>
</header>
